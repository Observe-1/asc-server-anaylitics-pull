# Copy to config.env and fill in. Paths starting /app are paths INSIDE the Docker
# container: /app is this folder (/mnt/user/appdata/asc-pull on Unraid).

OUT_DIR=/app/out

# --- Apple: where to find these ---------------------------------------------------
# App Store Connect > Users and Access > Integrations > App Store Connect API > Team Keys
#   Issuer ID: shown at the top of that page (same for every key)
#   Key ID:    shown next to each key. The .p8 file downloads once only.
# Put the .p8 files in the keys/ folder next to this file.

# 1. Admin key. Used only by "run.sh setup" to create the report requests. Delete it after.
ASC_SETUP_KEY_ID=
ASC_SETUP_ISSUER_ID=
ASC_SETUP_KEY_FILE=/app/keys/AuthKey_XXXXXXXXXX.p8

# 2. "Sales and Reports" key. Weekly analytics and Sales and Trends downloads.
ASC_REPORTS_KEY_ID=
ASC_REPORTS_ISSUER_ID=
ASC_REPORTS_KEY_FILE=/app/keys/AuthKey_XXXXXXXXXX.p8

# 3. "App Manager" key. Reviews, app version state, TestFlight builds. Optional:
#    without it the script tries key 2 and notes the gap in STATUS.
ASC_APPS_KEY_ID=
ASC_APPS_ISSUER_ID=
ASC_APPS_KEY_FILE=/app/keys/AuthKey_XXXXXXXXXX.p8

# Shortcut: ONE Admin key for everything instead of the three above (broader than needed).
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_FILE=/app/keys/AuthKey_XXXXXXXXXX.p8

# Sales and Trends vendor number: App Store Connect > Sales and Trends, or
# Payments and Financial Reports. Leave empty to skip sales data.
ASC_VENDOR_NUMBER=

# --- Optional tuning --------------------------------------------------------------
# Only these apps (comma list of names, bundle ids or app ids). Empty = every app on the account.
# ASC_APPS_INCLUDE=
# ASC_APPS_EXCLUDE=
# If your key's role cannot list apps, give them by hand: id:Name,id:Name
# ASC_APP_IDS=
ASC_STORE_COUNTRIES=gb,us
ASC_LAG_DAYS=2
# ASC_INCLUDE_DETAILED=0
# ASC_SKIP_CATEGORIES=FRAMEWORKS_USAGE
# ASC_RETENTION_DAYS=120

# --- Google Drive upload (remote name "gdrive" is created by "run.sh rclone") --------
RCLONE_DEST=gdrive:App Store Analytics

# Set to 1 to skip the Google Drive upload (files stay in out/latest on Oblivion,
# readable over SMB at \\Oblivion\appdata\asc-pull\out\latest). No rclone or Google sign-in needed.
ASC_SKIP_UPLOAD=0
